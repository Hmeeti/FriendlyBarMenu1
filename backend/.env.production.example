# Production environment template for hosted API (Render/Railway/Fly)
# Copy values into the host's Environment Variables UI — do NOT commit real secrets.

PORT=4000
HOST=0.0.0.0
NODE_ENV=production

# PostgreSQL connection from your host
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/friendly_menu?schema=public

JWT_SECRET=replace-with-long-random-string
JWT_EXPIRES_IN=8h
COOKIE_SECURE=true

# Comma-separated frontend origins (GitHub Pages + custom domain)
CLIENT_ORIGIN=https://YOUR_USER.github.io,https://YOUR_USER.github.io/YOUR_REPO

ADMIN_USERNAME=ilnur000
ADMIN_EMAIL=ilnur000@friendly.local
ADMIN_PASSWORD=replace-me
ADMIN_NAME=Ilnur
