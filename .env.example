# Copy to .env locally, or set these in Render → Environment

DATABASE_URL="file:./dev.db"
# On Render use Postgres, e.g.:
# DATABASE_URL="postgresql://USER:PASS@HOST/DB"

# Required: long random secret (24+ chars). Generate with: openssl rand -hex 32
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
JWT_EXPIRES_IN="8h"
PORT=4000
HOST=0.0.0.0

# Frontend origins allowed to call this API (comma-separated). Required in production.
CLIENT_ORIGIN="http://127.0.0.1:5501,http://localhost:5501,https://hmeeti.github.io"

# true on Render (HTTPS). Auto-enabled when NODE_ENV=production or RENDER=true.
COOKIE_SECURE=false

# First-boot admin (created only if missing). Do NOT commit real passwords.
ADMIN_USERNAME="your_admin_login"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="CHANGE_ME_STRONG_PASSWORD"
ADMIN_NAME="Admin"

# Owner / full access + audit logs UI (created only if missing)
OWNER_USERNAME="your_owner_login"
OWNER_EMAIL="owner@example.com"
OWNER_PASSWORD="CHANGE_ME_STRONG_PASSWORD"
OWNER_NAME="Owner"

# Set to 1 only when you intentionally want boot to overwrite admin passwords
# RESET_ADMIN_PASSWORD=1
