# Copy to .env locally, or set these in Render → Environment

DATABASE_URL="file:./dev.db"
# On Render use Postgres, e.g.:
# DATABASE_URL="postgresql://USER:PASS@HOST/DB"

# Required: long random secret (24+ chars). Generate with: openssl rand -hex 32
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
JWT_EXPIRES_IN="8h"
PORT=4000
HOST=0.0.0.0

# Frontend origins allowed to call this API (comma-separated).
# Must include the GitHub Pages origin (scheme + host, no path):
#   https://hmeeti.github.io
CLIENT_ORIGIN="http://127.0.0.1:5501,http://localhost:5501,https://hmeeti.github.io"

# true on Render (HTTPS). Auto-enabled when NODE_ENV=production or RENDER=true.
COOKIE_SECURE=false

# First-boot admin (created only if missing). Do NOT commit real passwords.
# Bootstrap admins — values on Render MUST be real logins (not example placeholders).
# On every boot passwords sync FROM these env vars (set RESET_ADMIN_PASSWORD=0 to disable).
ADMIN_USERNAME="ilnur000"
ADMIN_EMAIL="ilnur000@friendly.local"
ADMIN_PASSWORD="9987650"
ADMIN_NAME="Ilnur"

OWNER_USERNAME="hmeeti"
OWNER_EMAIL="hmeeti@friendly.local"
OWNER_PASSWORD="2289073"
OWNER_NAME="Hmeeti"

# RESET_ADMIN_PASSWORD=0
# AUTO_SEED=0
