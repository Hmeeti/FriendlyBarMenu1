# Copy to .env locally, or set these in Render → Environment

DATABASE_URL="file:./dev.db"
# On Render use Postgres, e.g.:
# DATABASE_URL="postgresql://USER:PASS@HOST/DB"

JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="8h"
PORT=4000
HOST=0.0.0.0

# Frontend origins allowed to call this API (comma-separated)
CLIENT_ORIGIN="http://127.0.0.1:5501,http://localhost:5501,http://127.0.0.1:5500,http://localhost:5500,https://friendlybarmenu1admin.onrender.com"

# true on Render (HTTPS)
COOKIE_SECURE=false

ADMIN_USERNAME="ilnur000"
ADMIN_EMAIL="ilnur000@friendly.local"
ADMIN_PASSWORD="9987650"
ADMIN_NAME="Ilnur"
